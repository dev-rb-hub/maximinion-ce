{
  "name": "maximinion",
  "displayName": "MaxiMinion",
  "description": "Local-first secret redaction and token counts for sharing code with AI assistants. Sanitize, compact, and copy files for LLM chats without changing your source.",
  "version": "0.3.0",
  "publisher": "maximinion",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/dev-rb-hub/maximinion-ce",
  "bugs": {
    "url": "https://github.com/dev-rb-hub/maximinion-ce/issues",
    "email": "support@maximinion.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-rb-hub/maximinion-ce"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["AI", "Linters", "Other"],
  "keywords": ["ai", "llm", "copilot", "chatgpt", "prompt", "context", "tokens", "secrets", "redact", "privacy"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "maximinion.copyForAI",
        "title": "Copy for AI (Sanitized)",
        "category": "MaxiMinion",
        "icon": "$(copy)"
      },
      {
        "command": "maximinion.sanitizeActiveFile",
        "title": "Sanitize Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.copySanitizedActiveFile",
        "title": "Copy Sanitized Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.runRefinerOnActiveFile",
        "title": "Run Refiner on Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.openSettings",
        "title": "Open Settings",
        "category": "MaxiMinion",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "maximinion.sanitizeActiveFile",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "maximinion.copyForAI",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@99"
        },
        {
          "command": "maximinion.copySanitizedActiveFile",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "maximinion.copyForAI",
          "when": "!explorerResourceIsFolder",
          "group": "6_copypath@99"
        }
      ],
      "view/title": [
        {
          "command": "maximinion.openSettings",
          "when": "view == maximinion.sidebar",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "maximinion.copyForAI",
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maximinion",
          "title": "MaxiMinion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "maximinion": [
        {
          "id": "maximinion.sidebar",
          "name": "MaxiMinion",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "MaxiMinion",
      "properties": {
        "maximinion.secretScrubbing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable secret scrubbing when running the Refiner on the active file."
        },
        "maximinion.entropyScoring.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Shannon entropy scoring of the active file's content."
        },
        "maximinion.semanticFolding.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable semantic folding via a local Ollama instance (requires Ollama running at http://localhost:11434). Depends on entropy scoring being enabled."
        },
        "maximinion.manifest.exportFormat": {
          "type": "string",
          "enum": ["json", "markdown"],
          "default": "json",
          "description": "Export format used when generating manifests."
        },
        "maximinion.tokenBudget": {
          "type": "number",
          "default": 8000,
          "minimum": 0,
          "description": "Estimated token budget for Copy for AI and the status bar indicator. Set to 0 to disable budget warnings. Estimates use ~4 characters per token."
        },
        "maximinion.copyForAI.compactWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Remove trailing whitespace (except in Markdown) and collapse repeated blank lines in Copy for AI output."
        },
        "maximinion.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the estimated token count for the active file or selection in the status bar."
        },
        "maximinion.secretDiagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline warnings for likely secrets in open files, with a quick fix to redact them."
        },
        "maximinion.secretDiagnostics.minConfidence": {
          "type": "number",
          "default": 0.75,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum pattern confidence (0-1) for inline secret warnings. Raise it to reduce false positives."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies",
    "dev": "npm run build && code --extensionDevelopmentPath=%cd% --new-window"
  },
  "devDependencies": {
    "@maximinion/refiner": "^0.2.1",
    "@types/vscode": "^1.74.0",
    "@types/jest": "^29.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
