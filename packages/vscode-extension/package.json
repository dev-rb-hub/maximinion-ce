{
  "name": "maximinion",
  "displayName": "MaxiMinion",
  "description": "Sanitize secrets from the active editor without changing the source file.",
  "version": "0.1.0",
  "publisher": "maximinion",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/dev-rb-hub/maximinion-ce",
  "bugs": {
    "url": "https://github.com/dev-rb-hub/maximinion-ce/issues",
    "email": "support@maximinion.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-rb-hub/maximinion-ce"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:maximinion.sanitizeActiveFile",
    "onCommand:maximinion.copySanitizedActiveFile",
    "onCommand:maximinion.runRefinerOnActiveFile",
    "onCommand:maximinion.openSettings",
    "onView:maximinion.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "maximinion.sanitizeActiveFile",
        "title": "Sanitize Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.copySanitizedActiveFile",
        "title": "Copy Sanitized Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.runRefinerOnActiveFile",
        "title": "Run Refiner on Active File",
        "category": "MaxiMinion"
      },
      {
        "command": "maximinion.openSettings",
        "title": "Open Settings",
        "category": "MaxiMinion",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "maximinion.sanitizeActiveFile",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "maximinion.copySanitizedActiveFile",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "maximinion.openSettings",
          "when": "view == maximinion.sidebar",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maximinion",
          "title": "MaxiMinion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "maximinion": [
        {
          "id": "maximinion.sidebar",
          "name": "MaxiMinion",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "MaxiMinion",
      "properties": {
        "maximinion.secretScrubbing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable secret scrubbing when running the Refiner on the active file."
        },
        "maximinion.entropyScoring.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Shannon entropy scoring of the active file's content."
        },
        "maximinion.semanticFolding.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable semantic folding via a local Ollama instance (requires Ollama running at http://localhost:11434). Depends on entropy scoring being enabled."
        },
        "maximinion.manifest.exportFormat": {
          "type": "string",
          "enum": ["json", "markdown"],
          "default": "json",
          "description": "Export format used when generating manifests."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package --no-dependencies",
    "dev": "npm run build && code --extensionDevelopmentPath=%cd% --new-window"
  },
  "devDependencies": {
    "@maximinion/refiner": "^0.1.1",
    "@types/vscode": "^1.74.0",
    "@types/jest": "^30.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.1.0",
    "typescript": "^7.0.2"
  }
}