# Phase 4: The Proxy Transport - Environment Configuration

# Server settings
SERVER_HOST=localhost
SERVER_PORT=3000
ENABLE_WEBSOCKET=true
ENABLE_HTTP=true

# Session settings
SESSION_TIMEOUT=3600000
MAX_CONCURRENT_SESSIONS=100
MAX_SESSION_CONTEXT_SIZE=52428800

# Streaming settings
STREAMING_ENABLED=true
STREAM_BATCH_SIZE=50
STREAM_UPDATE_INTERVAL=1000

# Cache settings
ENABLE_CACHING=true
CACHE_MAX_SIZE=209715200
CACHE_EVICTION_POLICY=LRU

# IDE settings
ENABLE_VSCODE_INTEGRATION=true
ENABLE_JETBRAINS_INTEGRATION=false

# Security settings
REQUIRE_AUTHENTICATION=false
CORS_ENABLED=true

# Logging and monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Performance tuning
CONTEXT_QUERY_TIMEOUT=5000
CONTEXT_SELECTION_ALGORITHM=importance_weighted
MAX_RELATED_NODES=20

# IDE specific
VSCODE_EXTENSION_VERSION=1.0.0
JETBRAINS_PLUGIN_VERSION=1.0.0

# Proxy settings
PROXY_HEARTBEAT_INTERVAL=30000
CONNECTION_IDLE_TIMEOUT=120000
