# Phase 3: The Manifest Generator - Environment Configuration

# Hierarchy settings
MAX_HIERARCHY_DEPTH=10
GROUP_BY_DIRECTORY=true
GROUP_BY_TYPE=true

# Analysis settings
INCLUDE_IMPORTS=true
INCLUDE_DOCSTRINGS=true
INCLUDE_METRICS=true
DETECT_CIRCULAR_DEPS=true
COMPUTE_CRITICAL_PATHS=true
CLUSTER_NODES=true

# Output settings
OUTPUT_FORMAT=json
INCLUDE_SOURCE_CODE=false
INCLUDE_METADATA=true

# Performance settings
ENABLE_CACHING=true
MAX_PROCESSING_TIME_MS=30000

# Language detection
LANGUAGE=typescript

# Cluster detection settings
MAX_CLUSTER_SIZE=20

# Critical path settings
MAX_CRITICAL_PATHS=10
DETECT_LONGEST_PATH=true

# Export settings
EXPORT_FORMATS=json,markdown,yaml
PRETTY_JSON=true

# Log level
LOG_LEVEL=info
